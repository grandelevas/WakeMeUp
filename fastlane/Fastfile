default_platform(:ios)

require_relative "signing_paths"

def bundle_id
  ENV.fetch("BUNDLE_ID", "com.grandelevas.wakemeup")
end

def widget_id
  "#{bundle_id}.widget"
end

def team_id
  ENV.fetch("APPLE_TEAM_ID")
end

def marketing_version
  project = File.read(File.join(WakeMeUpSigning::REPO_ROOT, "project.yml"))
  found = project[/^[ \t]*MARKETING_VERSION:[ \t]*"([^"]+)"/, 1]
  UI.user_error!("project.yml is missing MARKETING_VERSION") if found.to_s.empty?
  found
end

# A rejected upload can still occupy a build number. Take the higher of this
# workflow run and one past the newest TestFlight build for the same version.
def next_bundle_version(key)
  latest = latest_testflight_build_number(
    api_key: key,
    app_identifier: bundle_id,
    version: marketing_version,
    platform: "ios",
    initial_build_number: 0
  )
  chosen = [ENV["GITHUB_RUN_NUMBER"].to_i, latest.to_i + 1].max
  UI.user_error!("CFBundleVersion must be at least 1") if chosen < 1
  UI.message("CFBundleVersion #{chosen} (workflow run #{ENV['GITHUB_RUN_NUMBER'] || 'unset'}, TestFlight latest #{latest})")
  chosen.to_s
end

# setup_ci in fastlane 2.242 has no keychain_password option. It always creates
# this keychain with an empty password and records that in MATCH_KEYCHAIN_PASSWORD.
CI_KEYCHAIN_NAME = "fastlane_tmp_keychain"
CI_KEYCHAIN_PASSWORD = ""

def prepare_ci_keychain
  setup_ci(
    force: true,
    keychain_name: CI_KEYCHAIN_NAME
  )
end

def ci_keychain_path
  candidates = [
    File.expand_path("~/Library/Keychains/#{CI_KEYCHAIN_NAME}-db"),
    File.expand_path("~/Library/Keychains/#{CI_KEYCHAIN_NAME}.keychain-db"),
    File.expand_path("~/Library/Keychains/#{CI_KEYCHAIN_NAME}")
  ]
  found = candidates.find { |path| File.exist?(path) }
  unless found
    UI.user_error!("setup_ci did not create #{CI_KEYCHAIN_NAME}. Tried #{candidates.join(', ')}")
  end
  found
end

# produce cannot take an API key in fastlane 2.242 (that support was rolled back).
# cert, sigh, and upload_to_testflight can. The App Store Connect app record is
# created through Spaceship, which uses the same key.
def asc_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: File.join(WakeMeUpSigning::SIGNING_DIR, "AuthKey.p8"),
    duration: 1200,
    in_house: false
  )
end

def require_portal_bundle_ids!
  [bundle_id, widget_id].each do |identifier|
    found = Spaceship::ConnectAPI::BundleId.find(identifier)
    next if found

    UI.user_error!(<<~MSG)
      Bundle ID #{identifier} is not registered on the developer team.
      On iPhone, Safari → developer.apple.com/account/resources/identifiers → App IDs → +.
      Register #{identifier} before rerunning bootstrap-signing.
      No certificate was created.
    MSG
  end
end

def ensure_app_store_record!
  if Spaceship::ConnectAPI::App.find(bundle_id)
    UI.success("App Store Connect already has #{bundle_id}")
    return
  end

  UI.message("Creating the App Store Connect app record for #{bundle_id}")
  begin
    Spaceship::ConnectAPI::App.create(
      name: "WakeMeUp",
      version_string: "1.0",
      sku: "wakemeup-ios",
      primary_locale: "en-US",
      bundle_id: bundle_id,
      platforms: ["IOS"]
    )
  rescue StandardError => error
    UI.user_error!(<<~MSG)
      Could not create the App Store Connect app record: #{error.message}
      Create it yourself, then rerun bootstrap-signing. No certificate was created.
      iPhone: App Store Connect → Apps → the + button → New App.
      Platform iOS, name WakeMeUp (pick another name if that one is taken),
      primary language English (U.S.), bundle ID #{bundle_id}, SKU wakemeup-ios.
      Do not create an App Store record for the widget.
    MSG
  end
end

# cert's lane context points at the .cer. The PEM private key sits beside it
# with the same id and a .p12 suffix. Both paths are absolute because cert
# runs from the repo root.
def export_distribution_p12(output_dir)
  certificate_path = Actions.lane_context[SharedValues::CERT_FILE_PATH]
  if certificate_path.to_s.empty?
    UI.user_error!("cert did not set CERT_FILE_PATH")
  end
  certificate_path = WakeMeUpSigning.absolute_repo_path(certificate_path)
  key_path = certificate_path.sub(/\.cer\z/, ".p12")
  begin
    destination = WakeMeUpSigning.export_distribution_p12(
      output_dir: output_dir,
      certificate_path: certificate_path,
      key_path: key_path,
      password: ENV.fetch("DISTRIBUTION_CERTIFICATE_PASSWORD")
    )
  rescue StandardError => error
    UI.user_error!(error.message)
  end
  UI.success("Wrote #{destination}")
end

def create_app_store_profile(key, identifier, filename)
  sigh(
    api_key: key,
    app_identifier: identifier,
    team_id: team_id,
    platform: "ios",
    force: true,
    output_path: WakeMeUpSigning::SIGNING_OUT,
    filename: filename
  )
end

def refuse_bootstrap_when_p12_present!
  encoded = ENV["DISTRIBUTION_CERTIFICATE_P12_BASE64"].to_s
  return if encoded.strip.empty?

  UI.user_error!(<<~MSG)
    DISTRIBUTION_CERTIFICATE_P12_BASE64 is already set, so a distribution certificate already exists.
    bootstrap-signing would create another one. Run upload-testflight instead.
    No Apple API call was made.
  MSG
end

def parsed_distribution_identity!
  password = ENV.fetch("DISTRIBUTION_CERTIFICATE_PASSWORD")
  der = WakeMeUpSigning.decode_p12_base64(ENV.fetch("DISTRIBUTION_CERTIFICATE_P12_BASE64"))
  [WakeMeUpSigning.read_pkcs12(der, password), password]
rescue StandardError => error
  UI.user_error!(error.message)
end

# Compare the secret to the certificate before any App Store Connect call.
def require_certificate_team!(certificate)
  WakeMeUpSigning.assert_team_matches_certificate!(certificate, ENV.fetch("APPLE_TEAM_ID"))
rescue KeyError
  UI.user_error!("APPLE_TEAM_ID is not set. No Apple API call was made and the certificate was not imported.")
rescue StandardError => error
  UI.user_error!(error.message)
end

def install_distribution_identity!(pkcs12, password)
  assert_expected_distribution_certificate!(pkcs12.certificate)

  FileUtils.mkdir_p(WakeMeUpSigning::SIGNING_DIR)
  legacy_path = File.join(WakeMeUpSigning::SIGNING_DIR, "distribution.p12")
  WakeMeUpSigning.write_legacy_p12(
    key: pkcs12.key,
    certificate: pkcs12.certificate,
    password: password,
    destination: legacy_path
  )
  import_certificate(
    certificate_path: legacy_path,
    certificate_password: password,
    keychain_path: ci_keychain_path,
    keychain_password: CI_KEYCHAIN_PASSWORD
  )
end

def assert_expected_distribution_certificate!(certificate)
  certificate_id = WakeMeUpSigning::EXPECTED_DISTRIBUTION_CERTIFICATE_ID
  remote = Spaceship::ConnectAPI::Certificate.get(certificate_id: certificate_id)
  if remote.nil? || remote.certificate_content.to_s.empty?
    UI.user_error!("The team has no certificate #{certificate_id}. The p12 was not imported.")
  end
  remote_der = Base64.decode64(remote.certificate_content)
  return if remote_der == certificate.to_der

  UI.user_error!("The p12 is not distribution certificate #{certificate_id}. Refusing to sign with a different identity.")
end

platform :ios do
  desc "Check the portal, create the App Store record, then the distribution certificate and profiles"
  lane :bootstrap_signing do
    refuse_bootstrap_when_p12_present!
    key = asc_key
    prepare_ci_keychain

    # Everything above cert can fail without using a certificate slot.
    require_portal_bundle_ids!
    ensure_app_store_record!

    cert(
      api_key: key,
      development: false,
      force: false,
      team_id: team_id,
      output_path: WakeMeUpSigning::SIGNING_OUT,
      keychain_path: ci_keychain_path,
      keychain_password: CI_KEYCHAIN_PASSWORD
    )
    export_distribution_p12(WakeMeUpSigning::SIGNING_OUT)

    # Profiles are replaceable. If they fail, distribution.p12 is already on disk
    # and the workflow uploads signing-out even when this lane exits non-zero.
    begin
      create_app_store_profile(key, bundle_id, "app.mobileprovision")
      create_app_store_profile(key, widget_id, "widget.mobileprovision")
    rescue StandardError => error
      UI.error("Profiles were not created (#{error.message}).")
      UI.error("distribution.p12 is in the signing-bootstrap artifact. Do not run bootstrap-signing again.")
      raise
    end

    UI.success("Bootstrap finished. Download signing-bootstrap and encode distribution.p12 only.")
  end

  desc "Archive a Release build and upload it to TestFlight"
  lane :beta do
    pkcs12, password = parsed_distribution_identity!
    require_certificate_team!(pkcs12.certificate)
    key = asc_key
    prepare_ci_keychain
    install_distribution_identity!(pkcs12, password)
    sigh(
      api_key: key,
      app_identifier: bundle_id,
      team_id: team_id,
      platform: "ios",
      force: false,
      output_path: WakeMeUpSigning::SIGNING_OUT,
      filename: "app.mobileprovision"
    )
    app_profile_name = lane_context[SharedValues::SIGH_NAME]
    sigh(
      api_key: key,
      app_identifier: widget_id,
      team_id: team_id,
      platform: "ios",
      force: false,
      output_path: WakeMeUpSigning::SIGNING_OUT,
      filename: "widget.mobileprovision"
    )
    widget_profile_name = lane_context[SharedValues::SIGH_NAME]
    bundle_version = next_bundle_version(key)
    update_code_signing_settings(
      use_automatic_signing: false,
      path: WakeMeUpSigning::XCODEPROJ,
      team_id: team_id,
      code_sign_identity: "Apple Distribution",
      targets: ["WakeMeUp"],
      profile_name: app_profile_name,
      build_configurations: ["Release"]
    )
    update_code_signing_settings(
      use_automatic_signing: false,
      path: WakeMeUpSigning::XCODEPROJ,
      team_id: team_id,
      code_sign_identity: "Apple Distribution",
      targets: ["WakeMeUpWidget"],
      profile_name: widget_profile_name,
      build_configurations: ["Release"]
    )
    build_app(
      project: WakeMeUpSigning::XCODEPROJ,
      scheme: "WakeMeUp",
      configuration: "Release",
      output_directory: WakeMeUpSigning::BUILD_DIR,
      export_method: "app-store",
      export_team_id: team_id,
      export_options: {
        signingStyle: "manual",
        teamID: team_id,
        provisioningProfiles: {
          bundle_id => app_profile_name,
          widget_id => widget_profile_name
        }
      },
      xcargs: "DEVELOPMENT_TEAM=#{team_id} CODE_SIGN_STYLE=Manual CURRENT_PROJECT_VERSION=#{bundle_version}"
    )
    upload_to_testflight(
      api_key: key,
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end
end
